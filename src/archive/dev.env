# Local archive development defaults (issue #245). This file replaces all
# former AppHost environment injection and user secrets. It must stay
# commit-safe: the repository is public, so every value targets loopback
# emulator ports and there are no secrets here — never add any.
#
# Format: plain `KEY=value` lines (dotenv style; comments and blanks ignored,
# values must not contain spaces). Names such as the connection strings
# contain hyphens, so consumers pass the lines to `env` instead of sourcing
# them (`dev.sh` does this; `ConnectionStrings__*` cannot be plain shell
# assignments). See ../README.md for the exact commands.

# Development environment with the offline scripted chat provider.
ARCHIVE_ENVIRONMENT=Development
Archive__Chat__Provider=Scripted

# Local PostgreSQL 17.6 from compose.yaml (fixed development-only password).
ConnectionStrings__archive-db=postgresql://postgres:archive-local-dev@127.0.0.1:5432/archive
# Migration uses a separate, dedicated connection name; locally both point at
# the same database.
ConnectionStrings__archive-migrations=postgresql://postgres:archive-local-dev@127.0.0.1:5432/archive

# Local Azurite 3.35.0 from compose.yaml. The account key is Azurite's
# documented well-known emulator key, not a credential. The Blob port is
# pinned so emulator server-side copy resolves from inside the container.
ConnectionStrings__archive-blobs=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
ConnectionStrings__archive-queues=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1;

# Mailpit 1.27.8 from compose.yaml captures SMTP mail; its HTTP inbox shows it.
Mail__Provider=Smtp
Mail__Host=127.0.0.1
Mail__Port=1025

# Local OTLP endpoint for logs, traces and metrics. Default: the OpenTelemetry
# collector that `dev.sh up` starts on port 4318; point this at any local
# collector speaking HTTP/protobuf. Development refuses to start
# without an endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRIC_EXPORT_INTERVAL=5000

# Next.js frontend dev server (started by hand, see ../README.md). The Rust
# origin ignores these; the dev server rewrites browser /api/* to the API.
ARCHIVE_API_URL=http://localhost:8080
NEXT_TELEMETRY_DISABLED=1

# Pinned PDFium native library (bblanchon chromium/8138 linux-x64, see
# backend-rs/docs/image-native-notices.md). Only PDF extraction and Lesungen
# need it; every other command runs without it, and `dev.sh` prints a reminder
# when the path is unset. The code requires an absolute path, so the value
# stays machine-specific and is not committed: copy the library out of the
# local candidate image or download the publisher release, then uncomment and
# set the path (the git-ignored .local/ directory is a good home).
#
#   id=$(podman create localhost/liedertafel-archive:local)
#   mkdir -p .local/pdfium
#   podman cp "$id":/app/native/libpdfium.so .local/pdfium/libpdfium.so
#   podman rm "$id"
#
# Archive__Pdfium__LibraryPath=/absolute/path/to/libpdfium.so
