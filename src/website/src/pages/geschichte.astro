---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";

interface TimelineEntry {
	id: string;
	date: string;
	formattedDate: string;
	title: string;
	subtitle?: string;
	image?: ImageMetadata;
	hasContent: boolean;
	Content: Awaited<ReturnType<typeof render>>["Content"];
}

interface TimelineGroupDefinition {
	title: string;
	from: number;
	message?: string;
}

interface TimelineGroup extends TimelineGroupDefinition {
	to?: number;
	rangeLabel: string;
	entries: TimelineEntry[];
}

const formatHistoryDate = (rawDate: string) => {
	if (/^\d{4}$/.test(rawDate)) {
		return rawDate;
	}

	if (/^\d{4}-\d{2}$/.test(rawDate)) {
		const [year, month] = rawDate.split("-").map(Number);
		const parsedDate = new Date(Date.UTC(year, month - 1, 1));

		return new Intl.DateTimeFormat("de-AT", {
			month: "long",
			year: "numeric",
			timeZone: "UTC",
		}).format(parsedDate);
	}

	if (/^\d{4}-\d{2}-\d{2}$/.test(rawDate)) {
		const [year, month, day] = rawDate.split("-").map(Number);
		const parsedDate = new Date(Date.UTC(year, month - 1, day));

		return new Intl.DateTimeFormat("de-AT", {
			day: "2-digit",
			month: "long",
			year: "numeric",
			timeZone: "UTC",
		}).format(parsedDate);
	}

	return rawDate;
};

const getHistoryYear = (rawDate: string) => Number.parseInt(rawDate.slice(0, 4), 10);

const historyEntries = await getCollection("history");
const historyGroupConfigs = await getCollection("historyGroups");

if (historyGroupConfigs.length > 1) {
	throw new Error("Expected a single historyGroups entry in src/content/history-groups.");
}

const timelineEntries = await Promise.all(
	historyEntries
		.sort((first: (typeof historyEntries)[number], second: (typeof historyEntries)[number]) => second.data.date.localeCompare(first.data.date))
		.map(async (entry) => {
			const { Content } = await render(entry);

			return {
				id: entry.id,
				date: entry.data.date,
				formattedDate: formatHistoryDate(entry.data.date),
				title: entry.data.title,
				subtitle: entry.data.subtitle,
				image: entry.data.image,
				hasContent: (entry.body?.trim().length ?? 0) > 0,
				Content,
			} satisfies TimelineEntry;
		}),
);

const configuredGroups = historyGroupConfigs[0]?.data.groups;
const chronicleGroups: TimelineGroup[] = [];

if (timelineEntries.length > 0) {
	const earliestHistoryYear = timelineEntries.reduce(
		(earliestYear, entry) => Math.min(earliestYear, getHistoryYear(entry.date)),
		Number.POSITIVE_INFINITY,
	);

	const groupDefinitions: TimelineGroupDefinition[] = (
		configuredGroups?.length ? configuredGroups : [{ title: "Geschichte", from: earliestHistoryYear }]
	)
		.slice()
		.sort((first: TimelineGroupDefinition, second: TimelineGroupDefinition) => first.from - second.from);

	const timelineGroups: TimelineGroup[] = groupDefinitions.map((group, index) => {
		const nextGroup = groupDefinitions[index + 1];
		const to = nextGroup ? nextGroup.from - 1 : undefined;
		const rangeStart = index === 0 ? Math.min(group.from, earliestHistoryYear) : group.from;

		return {
			...group,
			to,
			rangeLabel: to ? `${rangeStart}-${to}` : `ab ${rangeStart}`,
			entries: [],
		};
	});

	timelineEntries.forEach((entry) => {
		const entryYear = getHistoryYear(entry.date);
		const groupIndex = groupDefinitions.findLastIndex((group) => entryYear >= group.from);
		const targetGroup = timelineGroups[groupIndex >= 0 ? groupIndex : 0];

		targetGroup?.entries.push(entry);
	});

	// The chronicle reads oldest first, like a book.
	chronicleGroups.push(
		...timelineGroups
			.filter((group) => group.entries.length > 0)
			.map((group) => ({
				...group,
				entries: [...group.entries].sort((first, second) => first.date.localeCompare(second.date)),
			})),
	);
}
---

<Layout>
	<section class="history-hero">
		<h1>Geschichte der Liedertafel Mining</h1>
	</section>

	{chronicleGroups.length > 0 ? (
		<section class="chronicle" aria-label="Vereinschronik">
			<nav class="chronicle-nav" aria-label="Chronik-Navigation">
				{
					chronicleGroups.map((group, groupIndex) => (
						<div class="chronicle-nav__segment" data-chronicle-segment data-era-idx={groupIndex}>
							<a class="chronicle-nav__era" href={`#chronicle-era-${groupIndex}`}>
								<span class="chronicle-nav__era-title">{group.title}</span>
								<span class="chronicle-nav__era-range">{group.rangeLabel}</span>
							</a>
							<span class="chronicle-nav__years">
								{group.entries.map((entry) => (
									<a class="chronicle-nav__year" data-chronicle-year={entry.id} href={`#${entry.id}`}>
										{entry.date.slice(0, 4)}
									</a>
								))}
							</span>
						</div>
					))
				}
			</nav>

			<ol class="chronicle-rail">
				{
					chronicleGroups.map((group, groupIndex) => [
						<li class="chronicle-era" id={`chronicle-era-${groupIndex}`} data-chronicle-marker data-era-idx={groupIndex}>
							<div class="chronicle-era__band">
								<h3>{group.title}</h3>
								<p>{group.rangeLabel}</p>
							</div>
							{group.message && <p class="chronicle-era__message">{group.message}</p>}
						</li>,
						...group.entries.map((entry) => (
							<li class="chronicle-entry" id={entry.id} data-chronicle-marker data-era-idx={groupIndex}>
								<details class="chronicle-card" data-history-entry={entry.id}>
									<summary>
										<span class="chronicle-date">{entry.formattedDate}</span>
										<div class="chronicle-header">
											<h4>{entry.title}</h4>
											{entry.subtitle && <p>{entry.subtitle}</p>}
										</div>
									</summary>
									{(entry.image || entry.hasContent) && (
										<div class="timeline-content">
											{entry.image && (
												<button
													type="button"
													class="timeline-image-trigger"
													data-image-src={entry.image.src}
													data-image-alt={`Bild zu ${entry.title}`}
													aria-label={`Bild zu ${entry.title} vergrößern`}
												>
													<Image src={entry.image} alt={`Bild zu ${entry.title}`} loading="lazy" />
												</button>
											)}
											{entry.hasContent && <entry.Content />}
										</div>
									)}
								</details>
							</li>
						)),
					])
				}
			</ol>
		</section>
	) : (
		<p class="chronicle-empty">Noch keine Chronik-Einträge vorhanden.</p>
	)}

	<dialog class="image-lightbox" aria-label="Bild vergrößert anzeigen">
		<button type="button" class="lightbox-close" aria-label="Vollbildansicht schließen">x</button>
		<button type="button" class="lightbox-nav lightbox-nav--prev" aria-label="Vorheriges Bild anzeigen">
			&lt;
		</button>
		<button type="button" class="lightbox-nav lightbox-nav--next" aria-label="Nächstes Bild anzeigen">
			&gt;
		</button>
		<figure class="lightbox-figure">
			<img class="lightbox-image" src="" alt="" />
			<figcaption class="lightbox-caption"></figcaption>
		</figure>
	</dialog>

	<Footer />
</Layout>

<script>
	const lightbox = document.querySelector<HTMLDialogElement>(".image-lightbox");
	const lightboxImage = lightbox?.querySelector<HTMLImageElement>(".lightbox-image");
	const lightboxCaption = lightbox?.querySelector<HTMLElement>(".lightbox-caption");
	const closeButton = lightbox?.querySelector<HTMLButtonElement>(".lightbox-close");
	const previousButton = lightbox?.querySelector<HTMLButtonElement>(".lightbox-nav--prev");
	const nextButton = lightbox?.querySelector<HTMLButtonElement>(".lightbox-nav--next");
	const triggers = document.querySelectorAll<HTMLButtonElement>(".timeline-image-trigger");
	const markdownImages = document.querySelectorAll<HTMLImageElement>(".timeline-content img");
	const timelineContents = document.querySelectorAll<HTMLElement>(".timeline-content");
	const historyDetails = document.querySelectorAll<HTMLDetailsElement>(".chronicle-card[data-history-entry]");

	const updateHistoryHash = (entryId?: string) => {
		const url = new URL(window.location.href);

		if (entryId) {
			url.hash = entryId;
			history.pushState(null, "", url);
			return;
		}

		if (!url.hash) {
			return;
		}

		url.hash = "";
		history.pushState(null, "", url);
	};

	const openHistoryEntry = (entryId: string, shouldScroll = true) => {
		const entry = document.getElementById(entryId);
		const details = document.querySelector<HTMLDetailsElement>(`[data-history-entry="${CSS.escape(entryId)}"]`);

		if (!entry || !details) {
			return;
		}

		if (!details.open) {
			details.open = true;
		}

		if (shouldScroll) {
			requestAnimationFrame(() => {
				entry.scrollIntoView({
					behavior: "smooth",
					block: "start",
				});
			});
		}
	};

	const syncHistoryEntryFromHash = () => {
		const entryId = decodeURIComponent(window.location.hash.slice(1));

		if (!entryId) {
			return;
		}

		openHistoryEntry(entryId);
	};

	type LightboxItem = {
		trigger: HTMLElement;
		getSource: () => string;
		getAlt: () => string;
	};

	let triggerElement: HTMLElement | null = null;
	let currentGroup: LightboxItem[] = [];
	let currentIndex = -1;

	const groupLookup = new Map<HTMLElement, LightboxItem[]>();
	const indexLookup = new Map<HTMLElement, number>();

	const setNavigationState = () => {
		const hasMultipleImages = currentGroup.length > 1;

		previousButton?.toggleAttribute("hidden", !hasMultipleImages);
		nextButton?.toggleAttribute("hidden", !hasMultipleImages);

		if (!hasMultipleImages) {
			if (previousButton) {
				previousButton.disabled = true;
			}

			if (nextButton) {
				nextButton.disabled = true;
			}

			return;
		}

		if (previousButton) {
			previousButton.disabled = currentIndex <= 0;
		}

		if (nextButton) {
			nextButton.disabled = currentIndex >= currentGroup.length - 1;
		}
	};

	const showImageAtIndex = (index: number) => {
		if (!lightboxImage || index < 0 || index >= currentGroup.length) {
			return;
		}

		currentIndex = index;
		const item = currentGroup[currentIndex];
		const alt = item.getAlt();

		lightboxImage.src = item.getSource();
		lightboxImage.alt = alt;
		if (lightboxCaption) {
			lightboxCaption.textContent = alt;
		}

		setNavigationState();
	};

	const openLightbox = (trigger: HTMLElement) => {
		if (!lightbox || !lightboxImage) {
			return;
		}

		triggerElement = trigger;
		currentGroup = groupLookup.get(trigger) ?? [];
		currentIndex = indexLookup.get(trigger) ?? 0;
		showImageAtIndex(currentIndex);
		lightbox.showModal();
	};

	const showPreviousImage = () => {
		showImageAtIndex(currentIndex - 1);
	};

	const showNextImage = () => {
		showImageAtIndex(currentIndex + 1);
	};

	const closeLightbox = () => {
		if (lightbox?.open) {
			lightbox.close();
			currentGroup = [];
			currentIndex = -1;
			triggerElement?.focus();
		}
	};

	timelineContents.forEach((content) => {
		const items: LightboxItem[] = [];

		const trigger = content.querySelector<HTMLButtonElement>(".timeline-image-trigger");
		if (trigger) {
			items.push({
				trigger,
				getSource: () => trigger.dataset.imageSrc ?? "",
				getAlt: () => trigger.dataset.imageAlt ?? "",
			});
		}

		content.querySelectorAll<HTMLImageElement>("img").forEach((image) => {
			if (image.closest(".timeline-image-trigger")) {
				return;
			}

			items.push({
				trigger: image,
				getSource: () => image.currentSrc || image.src,
				getAlt: () => image.alt,
			});
		});

		items.forEach((item, index) => {
			groupLookup.set(item.trigger, items);
			indexLookup.set(item.trigger, index);
		});
	});

	historyDetails.forEach((details) => {
		const entryId = details.dataset.historyEntry;

		if (!entryId) {
			return;
		}

		details.addEventListener("toggle", () => {
			if (details.open) {
				updateHistoryHash(entryId);
				return;
			}

			if (decodeURIComponent(window.location.hash.slice(1)) === entryId) {
				updateHistoryHash();
			}
		});
	});

	triggers.forEach((trigger) => {
		trigger.addEventListener("click", () => {
			openLightbox(trigger);
		});
	});

	markdownImages.forEach((image) => {
		if (image.closest(".timeline-image-trigger")) {
			return;
		}

		image.classList.add("timeline-markdown-image");
		image.setAttribute("role", "button");
		image.setAttribute("tabindex", "0");
		image.setAttribute("aria-label", `${image.alt || "Bild"} vergrößern`);

		image.addEventListener("click", () => {
			openLightbox(image);
		});

		image.addEventListener("keydown", (event) => {
			if (event.key !== "Enter" && event.key !== " ") {
				return;
			}

			event.preventDefault();
			openLightbox(image);
		});
	});

	closeButton?.addEventListener("click", closeLightbox);
	previousButton?.addEventListener("click", showPreviousImage);
	nextButton?.addEventListener("click", showNextImage);

	lightbox?.addEventListener("click", (event) => {
		const target = event.target;
		if (target instanceof HTMLDialogElement) {
			closeLightbox();
		}
	});

	document.addEventListener("keydown", (event) => {
		if (!lightbox?.open) {
			return;
		}

		if (event.key === "ArrowLeft") {
			event.preventDefault();
			showPreviousImage();
		}

		if (event.key === "ArrowRight") {
			event.preventDefault();
			showNextImage();
		}
	});

	window.addEventListener("hashchange", syncHistoryEntryFromHash);
	syncHistoryEntryFromHash();

	// Scroll-spy: highlight the era segment and the year currently in view.
	const chronicle = document.querySelector<HTMLElement>(".chronicle");

	if (chronicle) {
		const segments = Array.from(chronicle.querySelectorAll<HTMLElement>("[data-chronicle-segment]"));
		const years = Array.from(chronicle.querySelectorAll<HTMLElement>("[data-chronicle-year]"));
		const markers = Array.from(chronicle.querySelectorAll<HTMLElement>("[data-chronicle-marker]"));

		let spyFrame = 0;

		const updateSpy = () => {
			spyFrame = 0;
			const threshold = window.innerHeight * 0.35;
			let current: HTMLElement | null = null;

			for (const marker of markers) {
				if (marker.getBoundingClientRect().top <= threshold) {
					current = marker;
				} else {
					break;
				}
			}

			const activeEra = current?.dataset.eraIdx ?? "";
			const activeYear = current?.id ?? "";

			segments.forEach((segment) => {
				segment.classList.toggle("is-active", !!current && segment.dataset.eraIdx === activeEra);
			});

			years.forEach((year) => {
				year.classList.toggle("is-active", !!current && year.dataset.chronicleYear === activeYear);
			});
		};

		const scheduleSpy = () => {
			if (!spyFrame) {
				spyFrame = requestAnimationFrame(updateSpy);
			}
		};

		window.addEventListener("scroll", scheduleSpy, { passive: true });
		window.addEventListener("resize", scheduleSpy);
		window.addEventListener("load", scheduleSpy);
		// Re-measure after late layout shifts (fonts, images) settle
		window.setTimeout(scheduleSpy, 400);
		window.setTimeout(scheduleSpy, 1200);
		updateSpy();
	}
</script>

<style>
	/* The layout's overflow-x: hidden turns body into a scroll container and breaks
	   position: sticky (including the site navbar's). clip crops the same way
	   without creating a scroll container, so the chronicle navigation can stick. */
	:global(html:has(.chronicle)),
	:global(body:has(.chronicle)) {
		overflow-x: clip;
	}

	.history-hero {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		text-align: center;
	}

	.chronicle {
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
		max-width: 940px;
		--nav-top: 4.2rem;
	}

	.chronicle-empty {
		margin: 0;
		line-height: 1.6;
		opacity: 0.9;
	}

	.chronicle-nav {
		position: sticky;
		top: var(--nav-top);
		z-index: 6;
		display: flex;
		align-items: stretch;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scrollbar-width: none;
		padding: 0.35rem 0.55rem;
		background: rgba(0, 0, 0, 0.42);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255, 255, 255, 0.22);
		border-radius: 999px;
	}

	.chronicle-nav::-webkit-scrollbar {
		display: none;
	}

	.chronicle-nav__segment {
		display: inline-flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.2rem;
		padding: 0.45rem 0.55rem;
		border-radius: 0.9rem;
	}

	.chronicle-nav__segment + .chronicle-nav__segment {
		border-left: 1px solid rgba(255, 255, 255, 0.25);
		border-top-left-radius: 0;
		border-bottom-left-radius: 0;
	}

	.chronicle-nav__segment.is-active {
		background: rgba(255, 255, 255, 0.1);
	}

	.chronicle-nav__era {
		display: flex;
		align-items: baseline;
		gap: 0.45rem;
		color: inherit;
		text-decoration: none;
		padding: 0.15rem 0.45rem;
		border-radius: 0.35rem;
		white-space: nowrap;
	}

	.chronicle-nav__era:hover {
		background: rgba(255, 255, 255, 0.14);
	}

	.chronicle-nav__era-title {
		font-family: var(--font-heading);
		font-size: 0.95rem;
		font-weight: 500;
		line-height: 1.2;
	}

	.chronicle-nav__segment.is-active .chronicle-nav__era-title {
		text-decoration: underline;
		text-underline-offset: 0.2em;
		text-decoration-thickness: 1px;
	}

	.chronicle-nav__era-range {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		opacity: 0.75;
	}

	.chronicle-nav__years {
		display: flex;
		align-items: center;
		gap: 0.1rem;
		padding-left: 0.45rem;
	}

	.chronicle-nav__year {
		color: inherit;
		text-decoration: none;
		font-variant-numeric: tabular-nums;
		font-size: 0.8rem;
		line-height: 1;
		padding: 0.4rem 0.45rem;
		border-radius: 999px;
		border: 1px solid transparent;
		white-space: nowrap;
	}

	.chronicle-nav__year:hover {
		background: rgba(255, 255, 255, 0.16);
	}

	.chronicle-nav__year.is-active {
		background: rgba(255, 255, 255, 0.3);
		border-color: rgba(255, 255, 255, 0.5);
	}

	.chronicle-rail {
		list-style: none;
		margin: 0;
		padding: 0.3rem 0 1rem 1.9rem;
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		--dot-left: -1.35rem;
	}

	/* the one and only timeline line */
	.chronicle-rail::before {
		content: "";
		position: absolute;
		left: 0.55rem;
		top: 0.5rem;
		bottom: 1.6rem;
		width: 2px;
		background: rgba(255, 255, 255, 0.3);
	}

	.chronicle-era {
		position: relative;
		margin: 1.1rem 0 0.2rem;
		scroll-margin-top: 9.8rem;
		/* dot centers on the era band's title line (band padding + h3 line, baseline-shifted) */
		--dot-center: 1.67rem;
	}

	.chronicle-era::before {
		content: "";
		position: absolute;
		left: var(--dot-left);
		top: calc(var(--dot-center) - 0.475rem);
		transform: translateX(-50%);
		width: 0.95rem;
		height: 0.95rem;
		border-radius: 999px;
		border: 2px solid rgba(255, 255, 255, 0.85);
		background: rgba(255, 255, 255, 0.16);
		box-shadow: 0 0 0 0.3rem rgba(255, 255, 255, 0.08);
	}

	.chronicle-era__band {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.6rem 0.9rem;
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0.06) 100%);
		border: 1px solid rgba(255, 255, 255, 0.32);
		border-radius: 0.4rem;
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.14);
	}

	.chronicle-era__band h3 {
		margin: 0;
		font-size: 1.55rem;
	}

	.chronicle-era__band p {
		margin: 0;
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.85;
		white-space: nowrap;
	}

	.chronicle-era__message {
		margin: 0.6rem 0 0;
		line-height: 1.65;
		opacity: 0.9;
		white-space: pre-line;
	}

	.chronicle-entry {
		position: relative;
		scroll-margin-top: 9.8rem;
		/* dot centers on the summary title line */
		--dot-center: 1.96rem;
	}

	.chronicle-entry::before {
		content: "";
		position: absolute;
		left: var(--dot-left);
		top: calc(var(--dot-center) - 0.35rem);
		transform: translateX(-50%);
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 999px;
		border: 2px solid rgba(255, 255, 255, 0.78);
		background: var(--color-brand);
	}

	.chronicle-card {
		border-top: 1px solid rgba(255, 255, 255, 0.18);
	}

	.chronicle-card > summary {
		list-style: none;
		cursor: pointer;
		padding: 1.05rem 0.4rem;
		display: grid;
		grid-template-columns: 9rem minmax(0, 1fr);
		gap: 0.2rem 0.9rem;
		align-items: start;
	}

	.chronicle-card > summary::-webkit-details-marker {
		display: none;
	}

	.chronicle-date {
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.85;
		white-space: nowrap;
		padding-top: 0.35rem;
	}

	.chronicle-header h4 {
		font-family: var(--font-heading);
		font-size: 1.3rem;
		font-weight: 500;
		margin: 0;
		line-height: 1.3;
	}

	.chronicle-header p {
		margin: 0.4rem 0 0;
		opacity: 0.9;
		line-height: 1.5;
