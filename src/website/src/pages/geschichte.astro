---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";

interface TimelineEntry {
	id: string;
	date: string;
	formattedDate: string;
	title: string;
	subtitle?: string;
	image?: ImageMetadata;
	hasContent: boolean;
	Content: Awaited<ReturnType<typeof render>>["Content"];
}

interface TimelineGroupDefinition {
	title: string;
	from: number;
	message?: string;
}

interface TimelineGroup extends TimelineGroupDefinition {
	to?: number;
	rangeLabel: string;
	entries: TimelineEntry[];
}

const formatHistoryDate = (rawDate: string) => {
	if (/^\d{4}$/.test(rawDate)) {
		return rawDate;
	}

	if (/^\d{4}-\d{2}$/.test(rawDate)) {
		const [year, month] = rawDate.split("-").map(Number);
		const parsedDate = new Date(Date.UTC(year, month - 1, 1));

		return new Intl.DateTimeFormat("de-AT", {
			month: "long",
			year: "numeric",
			timeZone: "UTC",
		}).format(parsedDate);
	}

	if (/^\d{4}-\d{2}-\d{2}$/.test(rawDate)) {
		const [year, month, day] = rawDate.split("-").map(Number);
		const parsedDate = new Date(Date.UTC(year, month - 1, day));

		return new Intl.DateTimeFormat("de-AT", {
			day: "2-digit",
			month: "long",
			year: "numeric",
			timeZone: "UTC",
		}).format(parsedDate);
	}

	return rawDate;
};

const getHistoryYear = (rawDate: string) => Number.parseInt(rawDate.slice(0, 4), 10);

const historyEntries = await getCollection("history");
const historyGroupConfigs = await getCollection("historyGroups");

if (historyGroupConfigs.length > 1) {
	throw new Error("Expected a single historyGroups entry in src/content/history-groups.");
}

const timelineEntries = await Promise.all(
	historyEntries
		.sort((first: (typeof historyEntries)[number], second: (typeof historyEntries)[number]) => first.data.date.localeCompare(second.data.date))
		.map(async (entry) => {
			const { Content } = await render(entry);

			return {
				id: entry.id,
				date: entry.data.date,
				formattedDate: formatHistoryDate(entry.data.date),
				title: entry.data.title,
				subtitle: entry.data.subtitle,
				image: entry.data.image,
				hasContent: (entry.body?.trim().length ?? 0) > 0,
				Content,
			} satisfies TimelineEntry;
		}),
);

const configuredGroups = historyGroupConfigs[0]?.data.groups;
const visibleTimelineGroups: TimelineGroup[] = [];

if (timelineEntries.length > 0) {
	const earliestHistoryYear = timelineEntries.reduce(
		(earliestYear, entry) => Math.min(earliestYear, getHistoryYear(entry.date)),
		Number.POSITIVE_INFINITY,
	);

	const groupDefinitions: TimelineGroupDefinition[] = (
		configuredGroups?.length ? configuredGroups : [{ title: "Geschichte", from: earliestHistoryYear }]
	)
		.slice()
		.sort((first: TimelineGroupDefinition, second: TimelineGroupDefinition) => first.from - second.from);

	const timelineGroups: TimelineGroup[] = groupDefinitions.map((group, index) => {
		const nextGroup = groupDefinitions[index + 1];
		const to = nextGroup ? nextGroup.from - 1 : undefined;
		const rangeStart = index === 0 ? Math.min(group.from, earliestHistoryYear) : group.from;

		return {
			...group,
			to,
			rangeLabel: to ? `${rangeStart}–${to}` : `ab ${rangeStart}`,
			entries: [],
		};
	});

	timelineEntries.forEach((entry) => {
		const entryYear = getHistoryYear(entry.date);
		const groupIndex = groupDefinitions.findLastIndex((group) => entryYear >= group.from);
		const targetGroup = timelineGroups[groupIndex >= 0 ? groupIndex : 0];

		targetGroup?.entries.push(entry);
	});

	visibleTimelineGroups.push(...timelineGroups.filter((group) => group.entries.length > 0));
}

const chapterNumerals = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X"];

let zigzagIndex = 0;
---

<Layout>
	<section class="history-hero">
		<p class="history-hero__eyebrow">Vereinschronik</p>
		<h1>Geschichte der Liedertafel Mining</h1>
		<p>Stationen unseres Chors - von der Gründung bis heute.</p>
		<div class="history-hero__rule" aria-hidden="true"></div>
	</section>

	<section class="zigzag" aria-labelledby="timeline-heading">
		<h2 id="timeline-heading">Zeitleiste</h2>
		{visibleTimelineGroups.length > 0 ? (
			visibleTimelineGroups.map((group, groupIndex) => (
				<section class="era" aria-labelledby={`era-${group.from}`}>
					<header class="era__banner">
						<span class="era__chapter" aria-hidden="true">Kapitel {chapterNumerals[groupIndex] ?? ""}</span>
						<p class="era__range">{group.rangeLabel}</p>
						<h3 class="era__title" id={`era-${group.from}`}>{group.title}</h3>
						<p class="era__count">
							{group.entries.length} {group.entries.length === 1 ? "Eintrag" : "Einträge"}
						</p>
						{group.message && <p class="era__message">{group.message}</p>}
					</header>
					<ol class="era__entries">
						{
							group.entries.map((entry) => {
								const side = zigzagIndex % 2 === 0 ? "left" : "right";
								zigzagIndex += 1;

								return (
									<li class="entry" id={entry.id} data-side={side}>
										<article class="entry__card">
											<p class="entry__date">{entry.formattedDate}</p>
											<h4 class="entry__title">{entry.title}</h4>
											{entry.subtitle && <p class="entry__subtitle">{entry.subtitle}</p>}
											{entry.image && (
												<figure class="entry__figure">
													<button
														type="button"
														class="entry-image-trigger"
														data-image-src={entry.image.src}
														data-image-alt={`Bild zu ${entry.title}`}
														aria-label={`Bild zu ${entry.title} vergrößern`}
													>
														<Image src={entry.image} alt={`Bild zu ${entry.title}`} loading="lazy" />
													</button>
												</figure>
											)}
											{entry.hasContent && (
												<details class="entry__details">
													<summary>
														<span class="entry__details-label">Mehr lesen</span>
														<span class="entry__details-icon" aria-hidden="true"></span>
													</summary>
													<div class="entry__content">
														<entry.Content />
													</div>
												</details>
											)}
										</article>
									</li>
								);
							})
						}
					</ol>
				</section>
			))
		) : (
			<p class="zigzag-empty">Noch keine Chronik-Einträge vorhanden.</p>
		)}
	</section>

	<dialog class="image-lightbox" aria-label="Bild vergrößert anzeigen">
		<button type="button" class="lightbox-close" aria-label="Vollbildansicht schließen">x</button>
		<button type="button" class="lightbox-nav lightbox-nav--prev" aria-label="Vorheriges Bild anzeigen">
			&lt;
		</button>
		<button type="button" class="lightbox-nav lightbox-nav--next" aria-label="Nächstes Bild anzeigen">
			&gt;
		</button>
		<figure class="lightbox-figure">
			<img class="lightbox-image" src="" alt="" />
			<figcaption class="lightbox-caption"></figcaption>
		</figure>
	</dialog>

	<Footer />
</Layout>

<script>
	const lightbox = document.querySelector<HTMLDialogElement>(".image-lightbox");
	const lightboxImage = lightbox?.querySelector<HTMLImageElement>(".lightbox-image");
	const lightboxCaption = lightbox?.querySelector<HTMLElement>(".lightbox-caption");
	const closeButton = lightbox?.querySelector<HTMLButtonElement>(".lightbox-close");
	const previousButton = lightbox?.querySelector<HTMLButtonElement>(".lightbox-nav--prev");
	const nextButton = lightbox?.querySelector<HTMLButtonElement>(".lightbox-nav--next");
	const triggers = document.querySelectorAll<HTMLButtonElement>(".entry-image-trigger");
	const markdownImages = document.querySelectorAll<HTMLImageElement>(".entry__content img");
	const entryCards = document.querySelectorAll<HTMLElement>("li.entry");

	type LightboxItem = {
		trigger: HTMLElement;
		getSource: () => string;
		getAlt: () => string;
	};

	let triggerElement: HTMLElement | null = null;
	let currentGroup: LightboxItem[] = [];
	let currentIndex = -1;

	const groupLookup = new Map<HTMLElement, LightboxItem[]>();
	const indexLookup = new Map<HTMLElement, number>();

	const setNavigationState = () => {
		const hasMultipleImages = currentGroup.length > 1;

		previousButton?.toggleAttribute("hidden", !hasMultipleImages);
		nextButton?.toggleAttribute("hidden", !hasMultipleImages);

		if (!hasMultipleImages) {
			if (previousButton) {
				previousButton.disabled = true;
			}

			if (nextButton) {
				nextButton.disabled = true;
			}

			return;
		}

		if (previousButton) {
			previousButton.disabled = currentIndex <= 0;
		}

		if (nextButton) {
			nextButton.disabled = currentIndex >= currentGroup.length - 1;
		}
	};

	const showImageAtIndex = (index: number) => {
		if (!lightboxImage || index < 0 || index >= currentGroup.length) {
			return;
		}

		currentIndex = index;
		const item = currentGroup[currentIndex];
		const alt = item.getAlt();

		lightboxImage.src = item.getSource();
		lightboxImage.alt = alt;
		if (lightboxCaption) {
			lightboxCaption.textContent = alt;
		}

		setNavigationState();
	};

	const openLightbox = (trigger: HTMLElement) => {
		if (!lightbox || !lightboxImage) {
			return;
		}

		triggerElement = trigger;
		currentGroup = groupLookup.get(trigger) ?? [];
		currentIndex = indexLookup.get(trigger) ?? 0;
		showImageAtIndex(currentIndex);
		lightbox.showModal();
	};

	const showPreviousImage = () => {
		showImageAtIndex(currentIndex - 1);
	};

	const showNextImage = () => {
		showImageAtIndex(currentIndex + 1);
	};

	const closeLightbox = () => {
		if (lightbox?.open) {
			lightbox.close();
			currentGroup = [];
			currentIndex = -1;
			triggerElement?.focus();
		}
	};

	entryCards.forEach((card) => {
		const items: LightboxItem[] = [];

		const trigger = card.querySelector<HTMLButtonElement>(".entry-image-trigger");
		if (trigger) {
			items.push({
				trigger,
				getSource: () => trigger.dataset.imageSrc ?? "",
				getAlt: () => trigger.dataset.imageAlt ?? "",
			});
		}

		card.querySelectorAll<HTMLImageElement>("img").forEach((image) => {
			if (image.closest(".entry-image-trigger")) {
				return;
			}

			items.push({
				trigger: image,
				getSource: () => image.currentSrc || image.src,
				getAlt: () => image.alt,
			});
		});

		items.forEach((item, index) => {
			groupLookup.set(item.trigger, items);
			indexLookup.set(item.trigger, index);
		});
	});

	triggers.forEach((trigger) => {
		trigger.addEventListener("click", () => {
			openLightbox(trigger);
		});
	});

	markdownImages.forEach((image) => {
		if (image.closest(".entry-image-trigger")) {
			return;
		}

		image.classList.add("entry-markdown-image");
		image.setAttribute("role", "button");
		image.setAttribute("tabindex", "0");
		image.setAttribute("aria-label", `${image.alt || "Bild"} vergrößern`);

		image.addEventListener("click", () => {
			openLightbox(image);
		});

		image.addEventListener("keydown", (event) => {
			if (event.key !== "Enter" && event.key !== " ") {
				return;
			}

			event.preventDefault();
			openLightbox(image);
		});
	});

	closeButton?.addEventListener("click", closeLightbox);
	previousButton?.addEventListener("click", showPreviousImage);
	nextButton?.addEventListener("click", showNextImage);

	lightbox?.addEventListener("click", (event) => {
		const target = event.target;
		if (target instanceof HTMLDialogElement) {
			closeLightbox();
		}
	});

	document.addEventListener("keydown", (event) => {
		if (!lightbox?.open) {
			return;
		}

		if (event.key === "ArrowLeft") {
			event.preventDefault();
			showPreviousImage();
		}

		if (event.key === "ArrowRight") {
			event.preventDefault();
			showNextImage();
		}
	});
</script>

<style>
	.history-hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		text-align: center;
	}

	.history-hero__eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.2em;
		font-size: 0.85rem;
		font-weight: 600;
		margin: 0;
		opacity: 0.8;
	}

	.history-hero p {
		margin: 0;
		line-height: 1.6;
		opacity: 0.9;
		max-width: 44rem;
	}

	.history-hero__rule {
		position: relative;
		width: 5.5rem;
		height: 2px;
		background: rgba(255, 255, 255, 0.5);
		margin-top: 0.5rem;
	}

	.history-hero__rule::after {
		content: "";
		position: absolute;
		top: 50%;
		left: 50%;
		width: 0.55rem;
		height: 0.55rem;
		background: #ffffff;
		transform: translate(-50%, -50%) rotate(45deg);
	}

	.zigzag {
		max-width: 1100px;
		padding-left: 2rem;
		padding-right: 2rem;
		display: flex;
		flex-direction: column;
		gap: 4.5rem;
	}

	.zigzag-empty {
		margin: 0;
		line-height: 1.6;
		opacity: 0.9;
		text-align: center;
	}

	.era {
		display: flex;
		flex-direction: column;
	}

	.era__banner {
		position: relative;
		overflow: hidden;
		text-align: center;
		padding: 2.75rem 1.5rem 2.5rem;
		margin-bottom: 3rem;
		border-top: 1px solid rgba(255, 255, 255, 0.4);
		border-bottom: 1px solid rgba(255, 255, 255, 0.4);
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.1));
	}

	.era__chapter {
		position: absolute;
		top: 50%;
		right: 1.75rem;
		transform: translateY(-50%);
		font-family: var(--font-heading);
		font-size: 7.5rem;
		line-height: 1;
		opacity: 0.09;
		pointer-events: none;
	}

	.era__range {
		margin: 0;
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		opacity: 0.8;
	}

	.era__title {
		margin: 0.6rem 0 0;
		font-size: 2.1rem;
		line-height: 1.15;
	}

	.era__count {
		display: inline-flex;
		align-items: center;
		margin: 1rem 0 0;
		padding: 0.3rem 1rem;
		border: 1px solid rgba(255, 255, 255, 0.45);
		border-radius: 999px;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.era__message {
		margin: 1rem auto 0;
		max-width: 44rem;
		line-height: 1.65;
		font-style: italic;
		opacity: 0.88;
	}

	.era__entries {
		position: relative;
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	.era__entries::before {
		content: "";
		position: absolute;
		left: 50%;
		top: -3rem;
		bottom: 0;
		width: 2px;
		background: rgba(255, 255, 255, 0.32);
		transform: translateX(-50%);
	}

	.era:last-child .era__entries::before {
		bottom: -2.35rem;
	}

	.era:last-child .era__entries::after {
		content: "";
		position: absolute;
		left: 50%;
		bottom: -2.75rem;
		width: 0.7rem;
		height: 0.7rem;
		background: rgba(255, 255, 255, 0.85);
		transform: translateX(-50%) rotate(45deg);
	}

	.entry {
		position: relative;
		width: calc(50% - 3rem);
	}

	.entry[data-side="left"] {
		margin-right: auto;
	}

	.entry[data-side="right"] {
		margin-left: auto;
	}

	.entry::before {
		content: "";
		position: absolute;
		top: 2.2rem;
		width: 1rem;
		height: 1rem;
		border-radius: 999px;
		background: #ffffff;
		box-shadow: 0 0 0 0.4rem rgba(255, 255, 255, 0.08);
	}

	.entry[data-side="left"]::before {
		right: -3.5rem;
	}

	.entry[data-side="right"]::before {
		left: -3.5rem;
	}

	.entry::after {
		content: "";
		position: absolute;
		top: 2.2rem;
		width: 3rem;
		height: 2px;
		background: rgba(255, 255, 255, 0.32);
	}

	.entry[data-side="left"]::after {
		right: -3rem;
	}

	.entry[data-side="right"]::after {
		left: -3rem;
	}

	.entry__card {
		position: relative;
		padding: 1.5rem 1.5rem 1.25rem;
		border: 1px solid rgba(255, 255, 255, 0.24);
		border-top: 3px solid rgba(255, 255, 255, 0.62);
		border-radius: 4px;
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.05));
		box-shadow: 0 14px 30px rgba(0, 0, 0, 0.18);
		transition: transform 0.25s ease, border-color 0.25s ease;
	}

	.entry__card:hover {
		transform: translateY(-3px);
		border-color: rgba(255, 255, 255, 0.42);
	}

	.entry__date {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		opacity: 0.85;
	}

	.entry__date::before {
		content: "";
		width: 0.45rem;
		height: 0.45rem;
		flex-shrink: 0;
		background: #ffffff;
		opacity: 0.9;
		transform: rotate(45deg);
	}

	.entry__title {
		margin: 0.6rem 0 0;
		font-size: 1.45rem;
		line-height: 1.25;
		letter-spacing: 0.01em;
	}

	.entry__subtitle {
		margin: 0.5rem 0 0;
		line-height: 1.55;
		opacity: 0.92;
	}

	.entry__figure {
		margin: 1.1rem 0 0;
	}

	.entry__figure img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 3px;
	}

	.entry-image-trigger {
		display: block;
		width: 100%;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: zoom-in;
	}

	.entry__content :global(img.entry-markdown-image) {
		cursor: zoom-in;
	}

	.entry__details {
		margin-top: 1.1rem;
		border-top: 1px solid rgba(255, 255, 255, 0.16);
	}

	.entry__details > summary {
		list-style: none;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.95rem 0 0.1rem;
	}

	.entry__details > summary::-webkit-details-marker {
		display: none;
	}

	.entry__details > summary:focus-visible {
		outline: 2px solid rgba(255, 255, 255, 0.8);
		outline-offset: 4px;
		border-radius: 2px;
	}

	.entry__details-label {
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		opacity: 0.9;
	}

	.entry__details-icon {
		position: relative;
		width: 1.6rem;
		height: 1.6rem;
		flex-shrink: 0;
		border: 1px solid rgba(255, 255, 255, 0.5);
		border-radius: 999px;
		transition: transform 0.3s ease, border-color 0.3s ease;
	}

	.entry__details-icon::before,
	.entry__details-icon::after {
		content: "";
		position: absolute;
		top: 50%;
		left: 50%;
		background: #ffffff;
		transform: translate(-50%, -50%);
	}

	.entry__details-icon::before {
		width: 0.6rem;
		height: 2px;
	}

	.entry__details-icon::after {
		width: 2px;
		height: 0.6rem;
	}

	.entry__details[open] .entry__details-icon {
		transform: rotate(45deg);
		border-color: rgba(255, 255, 255, 0.9);
	}

	.entry__details:hover .entry__details-icon {
		border-color: rgba(255, 255, 255, 0.85);
	}

	.entry__content {
		padding-top: 0.25rem;
	}

	.entry__content :global(p) {
		margin: 0.9rem 0 0;
		line-height: 1.7;
		opacity: 0.95;
	}

	.entry__content :global(p:first-child) {
		margin-top: 0;
	}

	.entry__content :global(img) {
		display: block;
		max-width: 100%;
		height: auto;
		margin-top: 1rem;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 3px;
	}

	.entry__content :global(blockquote) {
		margin: 1.2rem 0 0;
		padding: 0.95rem 1.2rem;
		border-left: 3px solid rgba(255, 255, 255, 0.65);
		background: rgba(255, 255, 255, 0.07);
		font-style: italic;
		line-height: 1.7;
	}

	.entry__content :global(blockquote p) {
		margin: 0;
		opacity: 1;
	}

	.entry__content :global(blockquote p + p) {
		margin-top: 0.6rem;
	}

	.image-lightbox {
		padding: 0;
		border: 0;
		background: transparent;
		max-width: min(94vw, 1200px);
		max-height: 94vh;
		color-scheme: normal;
	}

	.image-lightbox::backdrop {
		background: rgba(0, 0, 0, 0.68);
	}

	.lightbox-figure {
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		background: transparent;
	}

	.lightbox-image {
		display: block;
		max-width: 100%;
		max-height: 88vh;
		width: auto;
		height: auto;
		object-fit: contain;
		box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
	}

	.lightbox-caption {
		padding: 0.5rem 0 0;
		font-size: 0.85rem;
		color: rgba(255, 255, 255, 0.8);
		text-align: left;
	}

	.lightbox-caption:empty {
		display: none;
	}

	.lightbox-close {
