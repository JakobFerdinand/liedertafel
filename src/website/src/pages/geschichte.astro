---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";

interface ChronicleEntry {
	id: string;
	date: string;
	formattedDate: string;
	title: string;
	subtitle?: string;
	hasContent: boolean;
	Content: Awaited<ReturnType<typeof render>>["Content"];
}

interface EraDefinition {
	title: string;
	from: number;
	message?: string;
}

interface Era extends EraDefinition {
	to?: number;
	rangeLabel: string;
	entries: ChronicleEntry[];
}

const formatHistoryDate = (rawDate: string) => {
	if (/^\d{4}$/.test(rawDate)) {
		return rawDate;
	}

	if (/^\d{4}-\d{2}$/.test(rawDate)) {
		const [year, month] = rawDate.split("-").map(Number);
		const parsedDate = new Date(Date.UTC(year, month - 1, 1));

		return new Intl.DateTimeFormat("de-AT", {
			month: "long",
			year: "numeric",
			timeZone: "UTC",
		}).format(parsedDate);
	}

	if (/^\d{4}-\d{2}-\d{2}$/.test(rawDate)) {
		const [year, month, day] = rawDate.split("-").map(Number);
		const parsedDate = new Date(Date.UTC(year, month - 1, day));

		return new Intl.DateTimeFormat("de-AT", {
			day: "2-digit",
			month: "long",
			year: "numeric",
			timeZone: "UTC",
		}).format(parsedDate);
	}

	return rawDate;
};

const getHistoryYear = (rawDate: string) => Number.parseInt(rawDate.slice(0, 4), 10);

const historyEntries = await getCollection("history");
const historyGroupConfigs = await getCollection("historyGroups");

if (historyGroupConfigs.length > 1) {
	throw new Error("Expected a single historyGroups entry in src/content/history-groups.");
}

const chronicleEntries = await Promise.all(
	historyEntries
		.sort((first: (typeof historyEntries)[number], second: (typeof historyEntries)[number]) => first.data.date.localeCompare(second.data.date))
		.map(async (entry) => {
			const { Content } = await render(entry);

			return {
				id: entry.id,
				date: entry.data.date,
				formattedDate: formatHistoryDate(entry.data.date),
				title: entry.data.title,
				subtitle: entry.data.subtitle,
				hasContent: (entry.body?.trim().length ?? 0) > 0,
				Content,
			} satisfies ChronicleEntry;
		}),
);

const configuredGroups = historyGroupConfigs[0]?.data.groups;
const visibleEras: Era[] = [];

if (chronicleEntries.length > 0) {
	const earliestHistoryYear = chronicleEntries.reduce(
		(earliestYear, entry) => Math.min(earliestYear, getHistoryYear(entry.date)),
		Number.POSITIVE_INFINITY,
	);

	const eraDefinitions: EraDefinition[] = (
		configuredGroups?.length ? configuredGroups : [{ title: "Geschichte", from: earliestHistoryYear }]
	)
		.slice()
		.sort((first: EraDefinition, second: EraDefinition) => first.from - second.from);

	const eras: Era[] = eraDefinitions.map((group, index) => {
		const nextGroup = eraDefinitions[index + 1];
		const to = nextGroup ? nextGroup.from - 1 : undefined;
		const rangeStart = index === 0 ? Math.min(group.from, earliestHistoryYear) : group.from;

		return {
			...group,
			to,
			rangeLabel: to ? `${rangeStart}-${to}` : `ab ${rangeStart}`,
			entries: [],
		};
	});

	chronicleEntries.forEach((entry) => {
		const entryYear = getHistoryYear(entry.date);
		const eraIndex = eraDefinitions.findLastIndex((group) => entryYear >= group.from);
		const targetEra = eras[eraIndex >= 0 ? eraIndex : 0];

		targetEra?.entries.push(entry);
	});

	visibleEras.push(...eras.filter((era) => era.entries.length > 0));
}

const entryCountLabel = (count: number) => `${count} ${count === 1 ? "Eintrag" : "Einträge"}`;
---

<Layout>
	<section class="history-hero">
		<p class="history-hero__eyebrow">Vereinschronik</p>
		<h1>Geschichte der Liedertafel Mining</h1>
		<p>Stationen unseres Chors - von der Gründung bis heute.</p>
		<div class="history-hero__rule" aria-hidden="true">
			<span></span>
		</div>
	</section>

	{visibleEras.length > 0 ? (
		<div class="chronicle">
			<aside class="chronicle__index" aria-label="Inhaltsverzeichnis der Vereinschronik">
				<p class="index__eyebrow">Inhaltsverzeichnis</p>
				<nav class="index__nav" aria-label="Epochen der Vereinsgeschichte">
					<ol class="index__list">
						{
							visibleEras.map((era) => (
								<li class="index__item">
									<a class="index__link" href={`#era-${era.from}`} data-era-link={era.from}>
										<span class="index__title">{era.title}</span>
										<span class="index__meta">
											{era.rangeLabel} · {entryCountLabel(era.entries.length)}
										</span>
									</a>
								</li>
							))
						}
					</ol>
				</nav>
			</aside>

			<div class="chronicle__body">
				{
					visibleEras.map((era) => (
						<section class="era" id={`era-${era.from}`} data-era={era.from} aria-labelledby={`era-heading-${era.from}`}>
							<header class="era__header">
								<h2 class="era__title" id={`era-heading-${era.from}`}>{era.title}</h2>
								<span class="era__diamond" aria-hidden="true"></span>
								<p class="era__meta">
									{era.rangeLabel} · {entryCountLabel(era.entries.length)}
								</p>
								{era.message && <p class="era__message">{era.message}</p>}
							</header>
							<div class="era__entries">
								{
									era.entries.map((entry) => (
										<article class="entry" id={entry.id}>
											<header class="entry__header">
												<p class="entry__year" aria-hidden="true">{getHistoryYear(entry.date)}</p>
												<div class="entry__heading">
													<p class="entry__date">{entry.formattedDate}</p>
													<h3 class="entry__title">{entry.title}</h3>
													{entry.subtitle && <p class="entry__subtitle">{entry.subtitle}</p>}
												</div>
											</header>
											{entry.hasContent && (
												<div class="entry__body">
													<entry.Content />
												</div>
											)}
										</article>
									))
								}
							</div>
						</section>
					))
				}
			</div>
		</div>
	) : (
		<p class="chronicle-empty">Noch keine Chronik-Einträge vorhanden.</p>
	)}

	<Footer />
</Layout>

<script>
	const eraLinks = document.querySelectorAll<HTMLAnchorElement>("[data-era-link]");
	const eraSections = document.querySelectorAll<HTMLElement>("[data-era]");

	const setActiveEra = (eraFrom: string) => {
		eraLinks.forEach((link) => {
			const isActive = link.dataset.eraLink === eraFrom;

			link.classList.toggle("is-active", isActive);

			if (isActive) {
				link.setAttribute("aria-current", "true");
			} else {
				link.removeAttribute("aria-current");
			}
		});
	};

	if ("IntersectionObserver" in window) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						setActiveEra((entry.target as HTMLElement).dataset.era ?? "");
					}
				}
			},
			{ rootMargin: "-96px 0px -60% 0px", threshold: 0 },
		);

		eraSections.forEach((section) => observer.observe(section));
	} else {
		setActiveEra(eraSections[0]?.dataset.era ?? "");
	}
</script>

<style>
	.history-hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		text-align: center;
	}

	.history-hero__eyebrow {
		margin: 0;
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		opacity: 0.8;
	}

	.history-hero p {
		margin: 0;
		line-height: 1.6;
		opacity: 0.9;
	}

	.history-hero__rule {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.65rem;
		margin-top: 1.35rem;
	}

	.history-hero__rule::before,
	.history-hero__rule::after {
		content: "";
		width: 2.75rem;
		height: 1px;
		background: rgba(255, 255, 255, 0.45);
	}

	.history-hero__rule span {
		width: 0.38rem;
		height: 0.38rem;
		transform: rotate(45deg);
		background: rgba(255, 255, 255, 0.75);
	}

	.chronicle {
		display: grid;
		grid-template-columns: 10.5rem minmax(0, 1fr);
		gap: 2.75rem;
		align-items: start;
	}

	.chronicle__index {
		position: sticky;
		top: 6rem;
	}

	.index__eyebrow {
		margin: 0 0 1rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		opacity: 0.7;
	}

	.index__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.index__link {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 0.4rem 0 0.4rem 1rem;
		border-left: 2px solid rgba(255, 255, 255, 0.28);
		color: inherit;
		text-decoration: none;
		transition: border-color 0.25s ease, opacity 0.25s ease;
	}

	.index__link:hover {
		border-left-color: rgba(255, 255, 255, 0.75);
	}

	.index__link.is-active {
		border-left-color: #ffffff;
	}

	.index__title {
		font-family: var(--font-heading);
		font-size: 1.05rem;
		line-height: 1.25;
	}

	.index__meta {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.65;
	}

	.index__link.is-active .index__title {
		opacity: 1;
	}

	.era {
		scroll-margin-top: 5.5rem;
	}

	.era__header {
		position: relative;
		padding: 0.15rem 0 2.25rem;
		text-align: center;
	}

	.era__header::before {
		content: "";
		position: absolute;
		top: 1.55rem;
		left: 0;
		right: 0;
		height: 1px;
		background: rgba(255, 255, 255, 0.32);
	}

	.era__title {
		position: relative;
		display: inline-block;
		margin: 0;
		padding: 0 1.5rem;
		background: var(--color-brand);
		font-size: 2rem;
	}

	.era__diamond {
		display: block;
		width: 0.4rem;
		height: 0.4rem;
		margin: 0.95rem auto 0;
		transform: rotate(45deg);
		background: rgba(255, 255, 255, 0.75);
	}

	.era__meta {
		margin: 0.6rem 0 0;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		opacity: 0.65;
	}

	.era__message {
		margin: 0.9rem auto 0;
		max-width: 30rem;
		font-style: italic;
		line-height: 1.6;
		opacity: 0.85;
	}

	.era__entries {
		display: flex;
		flex-direction: column;
	}

	.entry {
		scroll-margin-top: 5.5rem;
		padding: 1.9rem 0 2.1rem;
		border-top: 1px solid rgba(255, 255, 255, 0.16);
	}

	.entry__header {
		display: grid;
		grid-template-columns: 4.75rem minmax(0, 1fr);
		gap: 1.35rem;
		align-items: start;
	}

	.entry__year {
		margin: 0;
		font-family: var(--font-heading);
		font-size: 3rem;
		font-weight: 500;
		line-height: 1;
		letter-spacing: 0.02em;
		color: rgba(255, 255, 255, 0.5);
	}

	.entry__date {
		margin: 0 0 0.4rem;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		opacity: 0.65;
	}

	.entry__title {
		margin: 0;
		font-size: 1.4rem;
		line-height: 1.3;
	}

	.entry__subtitle {
		margin: 0.5rem 0 0;
		font-size: 1.02rem;
		font-style: italic;
		line-height: 1.55;
		opacity: 0.9;
	}

	.entry__body {
		margin-top: 1.15rem;
	}

	.entry__body :global(p) {
		margin: 0.9rem 0 0;
		font-size: 1.02rem;
		line-height: 1.72;
		opacity: 0.94;
	}

	.entry__body :global(p:first-child) {
		margin-top: 0;
	}

	.entry__body :global(img) {
		display: block;
		width: auto;
		max-width: 100%;
		height: auto;
		margin: 1.5rem auto 0;
		padding: 0.55rem;
		background: rgba(255, 255, 255, 0.07);
		border: 1px solid rgba(255, 255, 255, 0.42);
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
	}

	.entry__body :global(blockquote) {
		margin: 1.4rem 0 0;
		padding: 0.2rem 0 0.2rem 1.4rem;
		border-left: 2px solid rgba(255, 255, 255, 0.65);
	}

	.entry__body :global(blockquote p) {
		margin: 0;
		font-style: italic;
		opacity: 1;
	}

	.entry__body :global(blockquote p + p) {
		margin-top: 0.6rem;
	}

	.chronicle-empty {
		margin: 0;
		line-height: 1.6;
		opacity: 0.9;
	}

	@media (max-width: 900px) {
		.chronicle {
			display: flex;
			flex-direction: column;
			gap: 1.75rem;
		}

		.chronicle__index {
			position: static;
		}

		.index__eyebrow {
			margin-bottom: 0.75rem;
		}

		.index__list {
			flex-direction: row;
			gap: 0.55rem;
			overflow-x: auto;
			padding-bottom: 0.5rem;
			scrollbar-width: none;
		}

		.index__list::-webkit-scrollbar {
			display: none;
		}

		.index__item {
			flex: 0 0 auto;
		}

		.index__link {
			gap: 0.15rem;
			padding: 0.55rem 1rem;
			border-left: 0;
			border: 1px solid rgba(255, 255, 255, 0.3);
			border-radius: 999px;
			white-space: nowrap;
		}

		.index__link:hover,
		.index__link.is-active {
			border-color: rgba(255, 255, 255, 0.8);
			background: rgba(255, 255, 255, 0.14);
		}
	}

	@media (max-width: 600px) {
		.entry__header {
			grid-template-columns: 3.25rem minmax(0, 1fr);
			gap: 1rem;
		}

		.entry__year {
			font-size: 2.3rem;
		}

		.entry__title {
			font-size: 1.25rem;
		}

		.era__title {
			font-size: 1.6rem;
			padding: 0 1rem;
		}

		.era__header::before {
			top: 1.3rem;
		}
	}

	:global(html) {
		scroll-behavior: smooth;
	}

	@media (prefers-reduced-motion: reduce) {
		:global(html) {
			scroll-behavior: auto;
		}
	}
</style>
