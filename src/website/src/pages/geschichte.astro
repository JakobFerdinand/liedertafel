---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import TimelineOverview from "../components/TimelineOverview.svelte";

interface TimelineEntry {
	id: string;
	date: string;
	formattedDate: string;
	title: string;
	subtitle?: string;
	image?: ImageMetadata;
	hasContent: boolean;
	Content: Awaited<ReturnType<typeof render>>["Content"];
}

interface TimelineGroupDefinition {
	title: string;
	from: number;
	message?: string;
}

interface TimelineGroup extends TimelineGroupDefinition {
	to?: number;
	rangeLabel: string;
	entries: TimelineEntry[];
}

const formatHistoryDate = (rawDate: string) => {
	if (/^\d{4}$/.test(rawDate)) {
		return rawDate;
	}

	if (/^\d{4}-\d{2}$/.test(rawDate)) {
		const [year, month] = rawDate.split("-").map(Number);
		const parsedDate = new Date(Date.UTC(year, month - 1, 1));

		return new Intl.DateTimeFormat("de-AT", {
			month: "long",
			year: "numeric",
			timeZone: "UTC",
		}).format(parsedDate);
	}

	if (/^\d{4}-\d{2}-\d{2}$/.test(rawDate)) {
		const [year, month, day] = rawDate.split("-").map(Number);
		const parsedDate = new Date(Date.UTC(year, month - 1, day));

		return new Intl.DateTimeFormat("de-AT", {
			day: "2-digit",
			month: "long",
			year: "numeric",
			timeZone: "UTC",
		}).format(parsedDate);
	}

	return rawDate;
};

const getHistoryYear = (rawDate: string) => Number.parseInt(rawDate.slice(0, 4), 10);

const historyEntries = await getCollection("history");
const historyGroupConfigs = await getCollection("historyGroups");

if (historyGroupConfigs.length > 1) {
	throw new Error("Expected a single historyGroups entry in src/content/history-groups.");
}

const timelineEntries = await Promise.all(
	historyEntries
		.sort((first: (typeof historyEntries)[number], second: (typeof historyEntries)[number]) => second.data.date.localeCompare(first.data.date))
		.map(async (entry) => {
			const { Content } = await render(entry);

			return {
				id: entry.id,
				date: entry.data.date,
				formattedDate: formatHistoryDate(entry.data.date),
				title: entry.data.title,
				subtitle: entry.data.subtitle,
				image: entry.data.image,
				hasContent: (entry.body?.trim().length ?? 0) > 0,
				Content,
			} satisfies TimelineEntry;
		}),
);

const configuredGroups = historyGroupConfigs[0]?.data.groups;
const visibleTimelineGroups: TimelineGroup[] = [];
const todayYear = new Date().getFullYear();

if (timelineEntries.length > 0) {
	const earliestHistoryYear = timelineEntries.reduce(
		(earliestYear, entry) => Math.min(earliestYear, getHistoryYear(entry.date)),
		Number.POSITIVE_INFINITY,
	);

	const groupDefinitions: TimelineGroupDefinition[] = (
		configuredGroups?.length ? configuredGroups : [{ title: "Geschichte", from: earliestHistoryYear }]
	)
		.slice()
		.sort((first: TimelineGroupDefinition, second: TimelineGroupDefinition) => first.from - second.from);

	const timelineGroups: TimelineGroup[] = groupDefinitions.map((group, index) => {
		const nextGroup = groupDefinitions[index + 1];
		const to = nextGroup ? nextGroup.from - 1 : undefined;
		const rangeStart = index === 0 ? Math.min(group.from, earliestHistoryYear) : group.from;

		return {
			...group,
			to,
			rangeLabel: to ? `${rangeStart}-${to}` : `ab ${rangeStart}`,
			entries: [],
		};
	});

	timelineEntries.forEach((entry) => {
		const entryYear = getHistoryYear(entry.date);
		const groupIndex = groupDefinitions.findLastIndex((group) => entryYear >= group.from);
		const targetGroup = timelineGroups[groupIndex >= 0 ? groupIndex : 0];

		targetGroup?.entries.push(entry);
	});

	visibleTimelineGroups.push(...timelineGroups.filter((group) => group.entries.length > 0));

	visibleTimelineGroups.forEach((group) => {
		group.entries.reverse();
	});
}

const chartEras = visibleTimelineGroups.map((group) => ({
	from: group.from,
	to: group.to ?? null,
	title: group.title,
	rangeLabel: group.rangeLabel,
	message: group.message ?? "",
}));

const chartEvents = timelineEntries.map((entry) => ({
	id: entry.id,
	year: getHistoryYear(entry.date),
	label: entry.formattedDate,
	title: entry.title,
}));

const romanNumerals = ["I", "II", "III", "IV", "V", "VI"];

const handleOverviewJump = (event: Event) => {
	const detail = (event as CustomEvent<{ kind: "entry" | "era"; id?: string; from?: number }>).detail;

	if (detail.kind === "era" && detail.from) {
		document.getElementById(`era-${detail.from}`)?.scrollIntoView({
			behavior: "smooth",
			block: "start",
		});
		return;
	}

	if (detail.kind === "entry" && detail.id) {
		openHistoryEntry(detail.id);
	}
};
---

<Layout>
	<section class="history-hero">
		<p class="history-hero__eyebrow">Vereinschronik</p>
		<h1>Geschichte der Liedertafel Mining</h1>
		<p>Stationen unseres Chors - von der Gründung bis heute.</p>
	</section>

	<section class="overview-section" aria-labelledby="overview-heading">
		<h2 id="overview-heading">Die Chronik im Überblick</h2>
		{visibleTimelineGroups.length > 0 ? (
			<TimelineOverview client:idle events={chartEvents} eras={chartEras} today={todayYear} on:jump={handleOverviewJump} />
		) : (
			<p class="timeline-empty">Noch keine Chronik-Einträge vorhanden.</p>
		)}
	</section>

	<section class="chronik" aria-labelledby="chronik-heading">
		<h2 id="chronik-heading">Die Stationen im Detail</h2>
		{visibleTimelineGroups.length > 0 ? (
			visibleTimelineGroups.map((group, groupIndex) => (
				<section class="epoch" id={`era-${group.from}`} aria-labelledby={`era-title-${group.from}`}>
					<header class="epoch__header">
						<span class="epoch__numeral" aria-hidden="true">{romanNumerals[groupIndex] ?? groupIndex + 1}</span>
						<div class="epoch__heading">
							<h3 id={`era-title-${group.from}`}>{group.title}</h3>
							<p class="epoch__meta">
								{group.rangeLabel} · {group.entries.length} {group.entries.length === 1 ? "Eintrag" : "Einträge"}
							</p>
						</div>
					</header>
					{group.message && <p class="epoch__message">{group.message}</p>}
					<ul class="ledger">
						{group.entries.map((entry) => (
							<li class="ledger__row">
								<details class="ledger__details" id={entry.id} data-history-entry={entry.id}>
									<summary>
										<time class="ledger__date" datetime={entry.date}>{entry.formattedDate}</time>
										<span class="ledger__head">
											<span class="ledger__title">{entry.title}</span>
											{entry.subtitle && <span class="ledger__subtitle">{entry.subtitle}</span>}
										</span>
										<span class="ledger__chevron" aria-hidden="true">
											<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
												<polyline points="6 9 12 15 18 9"></polyline>
											</svg>
										</span>
									</summary>
									{(entry.image || entry.hasContent) && (
										<div class="ledger__body">
											{entry.image && (
												<button
													type="button"
													class="entry-image-trigger"
													data-image-src={entry.image.src}
													data-image-alt={`Bild zu ${entry.title}`}
													aria-label={`Bild zu ${entry.title} vergrößern`}
												>
													<Image src={entry.image} alt={`Bild zu ${entry.title}`} loading="lazy" />
												</button>
											)}
											{entry.hasContent && <entry.Content />}
										</div>
									)}
								</details>
							</li>
						))}
					</ul>
				</section>
			))
		) : (
			<p class="timeline-empty">Noch keine Chronik-Einträge vorhanden.</p>
		)}
	</section>

	<dialog class="image-lightbox" aria-label="Bild vergrößert anzeigen">
		<button type="button" class="lightbox-close" aria-label="Vollbildansicht schließen">x</button>
		<button type="button" class="lightbox-nav lightbox-nav--prev" aria-label="Vorheriges Bild anzeigen">
			&lt;
		</button>
		<button type="button" class="lightbox-nav lightbox-nav--next" aria-label="Nächstes Bild anzeigen">
			&gt;
		</button>
		<figure class="lightbox-figure">
			<img class="lightbox-image" src="" alt="" />
			<figcaption class="lightbox-caption"></figcaption>
		</figure>
	</dialog>

	<Footer />
</Layout>

<script>
	const lightbox = document.querySelector<HTMLDialogElement>(".image-lightbox");
	const lightboxImage = lightbox?.querySelector<HTMLImageElement>(".lightbox-image");
	const lightboxCaption = lightbox?.querySelector<HTMLElement>(".lightbox-caption");
	const closeButton = lightbox?.querySelector<HTMLButtonElement>(".lightbox-close");
	const previousButton = lightbox?.querySelector<HTMLButtonElement>(".lightbox-nav--prev");
	const nextButton = lightbox?.querySelector<HTMLButtonElement>(".lightbox-nav--next");
	const triggers = document.querySelectorAll<HTMLButtonElement>(".entry-image-trigger");
	const markdownImages = document.querySelectorAll<HTMLImageElement>(".ledger__body img");
	const ledgerBodies = document.querySelectorAll<HTMLElement>(".ledger__body");
	const historyDetails = document.querySelectorAll<HTMLDetailsElement>(".ledger__details[data-history-entry]");

	const updateHistoryHash = (entryId?: string) => {
		const url = new URL(window.location.href);

		if (entryId) {
			url.hash = entryId;
			history.pushState(null, "", url);
			return;
		}

		if (!url.hash) {
			return;
		}

		url.hash = "";
		history.pushState(null, "", url);
	};

	const openHistoryEntry = (entryId: string, shouldScroll = true) => {
		const entry = document.getElementById(entryId);
		const details = document.querySelector<HTMLDetailsElement>(`[data-history-entry="${CSS.escape(entryId)}"]`);

		if (!entry || !details) {
			return;
		}

		if (!details.open) {
			details.open = true;
		}

		if (shouldScroll) {
			requestAnimationFrame(() => {
				entry.scrollIntoView({
					behavior: "smooth",
					block: "start",
				});
			});
		}
	};

	const syncHistoryEntryFromHash = () => {
		const entryId = decodeURIComponent(window.location.hash.slice(1));

		if (!entryId) {
			return;
		}

		openHistoryEntry(entryId);
	};

	type LightboxItem = {
		trigger: HTMLElement;
		getSource: () => string;
		getAlt: () => string;
	};

	let triggerElement: HTMLElement | null = null;
	let currentGroup: LightboxItem[] = [];
	let currentIndex = -1;

	const groupLookup = new Map<HTMLElement, LightboxItem[]>();
	const indexLookup = new Map<HTMLElement, number>();

	const setNavigationState = () => {
		const hasMultipleImages = currentGroup.length > 1;

		previousButton?.toggleAttribute("hidden", !hasMultipleImages);
		nextButton?.toggleAttribute("hidden", !hasMultipleImages);

		if (!hasMultipleImages) {
			if (previousButton) {
				previousButton.disabled = true;
			}

			if (nextButton) {
				nextButton.disabled = true;
			}

			return;
		}

		if (previousButton) {
			previousButton.disabled = currentIndex <= 0;
		}

		if (nextButton) {
			nextButton.disabled = currentIndex >= currentGroup.length - 1;
		}
	};

	const showImageAtIndex = (index: number) => {
		if (!lightboxImage || index < 0 || index >= currentGroup.length) {
			return;
		}

		currentIndex = index;
		const item = currentGroup[currentIndex];
		const alt = item.getAlt();

		lightboxImage.src = item.getSource();
		lightboxImage.alt = alt;
		if (lightboxCaption) {
			lightboxCaption.textContent = alt;
		}

		setNavigationState();
	};

	const openLightbox = (trigger: HTMLElement) => {
		if (!lightbox || !lightboxImage) {
			return;
		}

		triggerElement = trigger;
		currentGroup = groupLookup.get(trigger) ?? [];
		currentIndex = indexLookup.get(trigger) ?? 0;
		showImageAtIndex(currentIndex);
		lightbox.showModal();
	};

	const showPreviousImage = () => {
		showImageAtIndex(currentIndex - 1);
	};

	const showNextImage = () => {
		showImageAtIndex(currentIndex + 1);
	};

	const closeLightbox = () => {
		if (lightbox?.open) {
			lightbox.close();
			currentGroup = [];
			currentIndex = -1;
			triggerElement?.focus();
		}
	};

	ledgerBodies.forEach((body) => {
		const items: LightboxItem[] = [];

		const trigger = body.querySelector<HTMLButtonElement>(".entry-image-trigger");
		if (trigger) {
			items.push({
				trigger,
				getSource: () => trigger.dataset.imageSrc ?? "",
				getAlt: () => trigger.dataset.imageAlt ?? "",
			});
		}

		body.querySelectorAll<HTMLImageElement>("img").forEach((image) => {
			if (image.closest(".entry-image-trigger")) {
				return;
			}

			items.push({
				trigger: image,
				getSource: () => image.currentSrc || image.src,
				getAlt: () => image.alt,
			});
		});

		items.forEach((item, index) => {
			groupLookup.set(item.trigger, items);
			indexLookup.set(item.trigger, index);
		});
	});

	historyDetails.forEach((details) => {
		const entryId = details.dataset.historyEntry;

		if (!entryId) {
			return;
		}

		details.addEventListener("toggle", () => {
			if (details.open) {
				updateHistoryHash(entryId);
				return;
			}

			if (decodeURIComponent(window.location.hash.slice(1)) === entryId) {
				updateHistoryHash();
			}
		});
	});

	triggers.forEach((trigger) => {
		trigger.addEventListener("click", () => {
			openLightbox(trigger);
		});
	});

	markdownImages.forEach((image) => {
		if (image.closest(".entry-image-trigger")) {
			return;
		}

		image.classList.add("ledger-markdown-image");
		image.setAttribute("role", "button");
		image.setAttribute("tabindex", "0");
		image.setAttribute("aria-label", `${image.alt || "Bild"} vergrößern`);

		image.addEventListener("click", () => {
			openLightbox(image);
		});

		image.addEventListener("keydown", (event) => {
			if (event.key !== "Enter" && event.key !== " ") {
				return;
			}

			event.preventDefault();
			openLightbox(image);
		});
	});

	closeButton?.addEventListener("click", closeLightbox);
	previousButton?.addEventListener("click", showPreviousImage);
	nextButton?.addEventListener("click", showNextImage);

	lightbox?.addEventListener("click", (event) => {
		const target = event.target;
		if (target instanceof HTMLDialogElement) {
			closeLightbox();
		}
	});

	document.addEventListener("keydown", (event) => {
		if (!lightbox?.open) {
			return;
		}

		if (event.key === "ArrowLeft") {
			event.preventDefault();
			showPreviousImage();
		}

		if (event.key === "ArrowRight") {
			event.preventDefault();
			showNextImage();
		}
	});

	window.addEventListener("hashchange", syncHistoryEntryFromHash);
	syncHistoryEntryFromHash();
</script>

<style>
	.history-hero {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		text-align: center;
	}

	.history-hero__eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.2em;
		font-size: 0.85rem;
		font-weight: 600;
		margin: 0;
		opacity: 0.8;
	}

	.history-hero p {
		margin: 0;
		line-height: 1.6;
		opacity: 0.9;
	}

	.overview-section {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.overview-section h2 {
		margin-bottom: 0;
	}

	.chronik {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.chronik h2 {
		margin-bottom: 0;
	}

	.timeline-empty {
		margin: 0;
		line-height: 1.6;
		opacity: 0.9;
	}

	.epoch {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		scroll-margin-top: 1.5rem;
	}

	.epoch__header {
		display: flex;
		align-items: start;
		gap: 1.25rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.35);
		padding-bottom: 1rem;
	}

	.epoch__numeral {
		font-family: var(--font-heading);
		font-size: 3.2rem;
		font-weight: 500;
		line-height: 1;
		opacity: 0.4;
		width: 4.5rem;
		flex-shrink: 0;
	}

	.epoch__heading {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.epoch__heading h3 {
		text-align: left;
		font-size: 1.8rem;
	}

	.epoch__meta {
		margin: 0;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		opacity: 0.75;
	}

	.epoch__message {
		margin: 0;
		line-height: 1.65;
		opacity: 0.9;
		white-space: pre-line;
	}

	.ledger {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		border-top: 1px solid rgba(255, 255, 255, 0.14);
	}

	.ledger__row {
		border-bottom: 1px solid rgba(255, 255, 255, 0.14);
	}

	.ledger__details summary {
		list-style: none;
		cursor: pointer;
		position: relative;
		display: grid;
		grid-template-columns: 7.5rem minmax(0, 1fr) 2rem;
		gap: 1.25rem;
		align-items: center;
		padding: 1.15rem 0.5rem;
		transition: background 0.2s ease;
	}

	.ledger__details summary::-webkit-details-marker {
		display: none;
	}

	.ledger__details summary::before {
		content: "";
		position: absolute;
		left: 0.5rem;
		top: 1.6rem;
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 999px;
		border: 2px solid rgba(255, 255, 255, 0.85);
		background: rgba(255, 255, 255, 0.12);
	}

	.ledger__details summary:hover,
	.ledger__details summary:focus-visible {
		background: rgba(255, 255, 255, 0.07);
	}

	.ledger__date {
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.85;
		white-space: nowrap;
		padding-left: 1.4rem;
	}

	.ledger__head {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}

	.ledger__title {
		font-family: var(--font-heading);
		font-size: 1.25rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		line-height: 1.3;
	}

	.ledger__subtitle {
		font-size: 0.95rem;
		line-height: 1.5;
		opacity: 0.88;
	}

	.ledger__chevron {
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0.6;
		transition: transform 0.25s ease, opacity 0.2s ease;
	}

	.ledger__details[open] .ledger__chevron {
		transform: rotate(180deg);
		opacity: 1;
	}

	.ledger__body {
		padding: 0 3.5rem 1.25rem;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
	}

	.ledger__body :global(p) {
		margin: 1rem 0 0;
		line-height: 1.65;
		opacity: 0.95;
	}

	.ledger__body :global(blockquote) {
		position: relative;
		margin: 1.35rem 0 0;
		padding: 1.15rem 1.35rem 1.15rem 3.4rem;
		border-left: 3px solid rgba(255, 255, 255, 0.72);
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.055));
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
	}

	.ledger__body :global(blockquote::before) {
		content: "\201C";
		position: absolute;
		top: 0.55rem;
		left: 1rem;
		font-family: var(--font-heading);
		font-size: 3.1rem;
		line-height: 1;
		color: rgba(255, 255, 255, 0.68);
	}

	.ledger__body :global(blockquote p) {
		margin: 0;
		font-style: italic;
		line-height: 1.72;
		opacity: 1;
	}

	.ledger__body :global(blockquote p + p) {
		margin-top: 0.65rem;
	}

	.entry-image-trigger img {
		display: block;
		width: 100%;
		max-height: 280px;
		object-fit: contain;
	}

	.ledger__body :global(img.ledger-markdown-image) {
		display: block;
		width: auto;
		max-width: 100%;
		height: auto;
		margin-top: 1rem;
		cursor: zoom-in;
	}

	.entry-image-trigger {
		display: block;
		width: 100%;
		margin: 1rem 0 0;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: zoom-in;
	}

	.image-lightbox {
		padding: 0;
		border: 0;
		background: transparent;
		max-width: min(94vw, 1200px);
		max-height: 94vh;
		color-scheme: normal;
	}

	.image-lightbox::backdrop {
		background: rgba(0, 0, 0, 0.68);
	}

	.lightbox-figure {
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		background: transparent;
	}

	.lightbox-image {
		display: block;
		max-width: 100%;
		max-height: 88vh;
		width: auto;
		height: auto;
		object-fit: contain;
		box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
	}

	.lightbox-caption {
		padding: 0.5rem 0 0;
		font-size: 0.85rem;
		color: rgba(255, 255, 255, 0.8);
		text-align: left;
	}

	.lightbox-caption:empty {
		display: none;
	}

	.lightbox-close {
		position: fixed;
		top: 1rem;
		right: 1rem;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.45);
		background: rgba(0, 0, 0, 0.5);
		color: #fff;
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1;
		cursor: pointer;
	}

	.lightbox-close:hover {
		background: rgba(0, 0, 0, 0.7);
