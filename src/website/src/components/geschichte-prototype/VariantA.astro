---
// PROTOTYPE (throwaway) — Variant A «Ein Strang», merged with B's grouping:
// ONE timeline line for the whole chronicle, eras as markers on the line,
// and a sticky navigation bar on top where each era segment groups its years
// (era name jumps to the era marker, a year jumps to the entry and opens it).
// A scroll-spy highlights the era and year currently in view. View via /geschichte?proto=A
import type { PrototypeGroup } from "./types";
import { Image } from "astro:assets";

interface Props {
	groups: PrototypeGroup[];
}

const { groups } = Astro.props;
const mark = (id: string) => `gp-a-${id}`;
const eraAnchor = (index: number) => `gp-a-era-${index}`;
---

<div class="gp-a" data-gp-a>
	<nav class="gp-a__bar" aria-label="Chronik-Navigation">
		{
			groups.map((group, groupIndex) => (
				<div class="gp-a__bar-segment" data-gp-a-segment data-era-idx={groupIndex}>
					<a class="gp-a__bar-era" href={`#${eraAnchor(groupIndex)}`}>
						<span class="gp-a__bar-era-title">{group.title}</span>
						<span class="gp-a__bar-era-range">{group.rangeLabel}</span>
					</a>
					<span class="gp-a__bar-years">
						{group.entries.map((entry) => (
							<a class="gp-a__bar-year" data-gp-a-year data-year={mark(entry.id)} href={`#${mark(entry.id)}`}>
								{entry.date.slice(0, 4)}
							</a>
						))}
					</span>
				</div>
			))
		}
	</nav>

	<ol class="gp-a__rail">
		{
			groups.map((group, groupIndex) => [
				<li class="gp-a__era" id={eraAnchor(groupIndex)} data-gp-a-marker data-era-idx={groupIndex}>
					<div class="gp-a__era-head">
						<h3>{group.title}</h3>
						<p>{group.rangeLabel}</p>
					</div>
					{group.message && <p class="gp-a__era-message">{group.message}</p>}
				</li>,
				...group.entries.map((entry) => (
					<li class="gp-a__item" id={mark(entry.id)} data-gp-a-marker data-era-idx={groupIndex}>
						<details class="gp-a__card" data-history-entry={mark(entry.id)}>
							<summary>
								<span class="gp-a__date">{entry.formattedDate}</span>
								<div class="gp-a__heading">
									<h4>{entry.title}</h4>
									{entry.subtitle && <p>{entry.subtitle}</p>}
								</div>
							</summary>
							{(entry.image || entry.hasContent) && (
								<div class="timeline-content">
									{entry.image && (
										<button
											type="button"
											class="timeline-image-trigger"
											data-image-src={entry.image.src}
											data-image-alt={`Bild zu ${entry.title}`}
											aria-label={`Bild zu ${entry.title} vergrößern`}
										>
											<Image src={entry.image} alt={`Bild zu ${entry.title}`} loading="lazy" />
										</button>
									)}
									{entry.hasContent && <entry.Content />}
								</div>
							)}
						</details>
					</li>
				)),
			])
		}
	</ol>
</div>

<style>
	.gp-a {
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
		--bar-top: 4.2rem;
	}

	.gp-a__bar {
		position: sticky;
		top: var(--bar-top);
		z-index: 6;
		display: flex;
		align-items: stretch;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scrollbar-width: none;
		padding: 0.35rem 0.55rem;
		background: rgba(0, 0, 0, 0.42);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255, 255, 255, 0.22);
		border-radius: 999px;
	}

	.gp-a__bar::-webkit-scrollbar {
		display: none;
	}

	.gp-a__bar-segment {
		display: inline-flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.2rem;
		padding: 0.45rem 0.55rem;
		border-radius: 0.9rem;
	}

	.gp-a__bar-segment + .gp-a__bar-segment {
		border-left: 1px solid rgba(255, 255, 255, 0.25);
		border-top-left-radius: 0;
		border-bottom-left-radius: 0;
	}

	.gp-a__bar-segment.is-active {
		background: rgba(255, 255, 255, 0.1);
	}

	.gp-a__bar-era {
		display: flex;
		align-items: baseline;
		gap: 0.45rem;
		color: inherit;
		text-decoration: none;
		padding: 0.15rem 0.45rem;
		border-radius: 0.35rem;
		white-space: nowrap;
	}

	.gp-a__bar-era:hover {
		background: rgba(255, 255, 255, 0.14);
	}

	.gp-a__bar-era-title {
		font-family: var(--font-heading);
		font-size: 0.95rem;
		font-weight: 500;
		line-height: 1.2;
	}

	.gp-a__bar-segment.is-active .gp-a__bar-era-title {
		text-decoration: underline;
		text-underline-offset: 0.2em;
		text-decoration-thickness: 1px;
	}

	.gp-a__bar-era-range {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		opacity: 0.75;
	}

	.gp-a__bar-years {
		display: flex;
		align-items: center;
		gap: 0.1rem;
		padding-left: 0.45rem;
	}

	.gp-a__bar-year {
		color: inherit;
		text-decoration: none;
		font-variant-numeric: tabular-nums;
		font-size: 0.8rem;
		line-height: 1;
		padding: 0.4rem 0.45rem;
		border-radius: 999px;
		border: 1px solid transparent;
		white-space: nowrap;
	}

	.gp-a__bar-year:hover {
		background: rgba(255, 255, 255, 0.16);
	}

	.gp-a__bar-year.is-active {
		background: rgba(255, 255, 255, 0.3);
		border-color: rgba(255, 255, 255, 0.5);
	}

	.gp-a__rail {
		list-style: none;
		margin: 0;
		padding: 0.3rem 0 1rem 1.9rem;
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		--dot-left: -1.35rem;
	}

	/* the one and only timeline line */
	.gp-a__rail::before {
		content: "";
		position: absolute;
		left: 0.55rem;
		top: 0.5rem;
		bottom: 1.6rem;
		width: 2px;
		background: rgba(255, 255, 255, 0.3);
	}

	.gp-a__era {
		position: relative;
		margin: 1.1rem 0 0.2rem;
		scroll-margin-top: 9.8rem;
	}

	.gp-a__era::before {
		content: "";
		position: absolute;
		left: var(--dot-left);
		top: 0.72rem;
		transform: translateX(-50%);
		width: 0.95rem;
		height: 0.95rem;
		border-radius: 999px;
		border: 2px solid rgba(255, 255, 255, 0.78);
		background: rgba(255, 255, 255, 0.12);
		box-shadow: 0 0 0 0.3rem rgba(255, 255, 255, 0.06);
	}

	.gp-a__era-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.gp-a__era-head h3 {
		margin: 0;
		font-size: 1.55rem;
	}

	.gp-a__era-head p {
		margin: 0;
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.85;
		white-space: nowrap;
	}

	.gp-a__era-message {
		margin: 0.6rem 0 0;
		line-height: 1.65;
		opacity: 0.9;
		white-space: pre-line;
	}

	.gp-a__item {
		position: relative;
		scroll-margin-top: 9.8rem;
	}

	.gp-a__item::before {
		content: "";
		position: absolute;
		left: var(--dot-left);
		top: 1.55rem;
		transform: translateX(-50%);
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 999px;
		border: 2px solid rgba(255, 255, 255, 0.78);
		background: var(--color-brand);
	}

	.gp-a__card {
		border-top: 1px solid rgba(255, 255, 255, 0.18);
	}

	.gp-a__card > summary {
		list-style: none;
		cursor: pointer;
		padding: 1.05rem 0.4rem;
		display: grid;
		grid-template-columns: 9rem minmax(0, 1fr);
		gap: 0.2rem 0.9rem;
		align-items: start;
	}

	.gp-a__card > summary::-webkit-details-marker {
		display: none;
	}

	.gp-a__date {
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.85;
		white-space: nowrap;
		padding-top: 0.35rem;
	}

	.gp-a__heading h4 {
		font-family: var(--font-heading);
		font-size: 1.3rem;
		font-weight: 500;
		margin: 0;
		line-height: 1.3;
	}

	.gp-a__heading p {
		margin: 0.4rem 0 0;
		opacity: 0.9;
		line-height: 1.5;
	}

	.gp-a__card > summary:hover {
		background: rgba(255, 255, 255, 0.06);
	}

	.gp-a__card[open] > summary {
		padding-bottom: 0.6rem;
	}

	.gp-a .timeline-content {
		padding: 0 0.4rem 1.1rem calc(9rem + 0.9rem);
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.gp-a .timeline-content > * {
		margin: 0;
	}

	.gp-a .timeline-content :global(p) {
		line-height: 1.65;
		opacity: 0.95;
	}

	.gp-a .timeline-content :global(img) {
		display: block;
		max-width: 100%;
		height: auto;
	}

	.gp-a .timeline-image-trigger {
		display: block;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: zoom-in;
		margin: 0;
	}

	.gp-a .timeline-image-trigger :global(img) {
		width: 100%;
		max-height: 15rem;
		object-fit: contain;
	}

	@media (max-width: 600px) {
		.gp-a {
			--bar-top: 4.8rem;
		}

		.gp-a__rail {
			padding-left: 1.3rem;
			--dot-left: -0.75rem;
		}

		.gp-a__era {
			scroll-margin-top: 10.4rem;
		}

		.gp-a__item {
			scroll-margin-top: 10.4rem;
		}

		.gp-a__card > summary {
			grid-template-columns: 1fr;
			gap: 0.4rem;
			padding: 0.9rem 0.1rem;
		}

		.gp-a__date {
			padding-top: 0;
		}

		.gp-a .timeline-content {
			padding: 0 0.1rem 1rem;
		}
	}
</style>

<script>
	const root = document.querySelector<HTMLElement>("[data-gp-a]");

	if (root) {
		const segments = Array.from(root.querySelectorAll<HTMLElement>("[data-gp-a-segment]"));
		const years = Array.from(root.querySelectorAll<HTMLElement>("[data-gp-a-year]"));
		const markers = Array.from(root.querySelectorAll<HTMLElement>("[data-gp-a-marker]"));

		let frame = 0;

		const update = () => {
			frame = 0;
			const threshold = window.innerHeight * 0.35;
			let current: HTMLElement | null = null;

			for (const marker of markers) {
				if (marker.getBoundingClientRect().top <= threshold) {
					current = marker;
				} else {
					break;
				}
			}

			const activeEra = current?.dataset.eraIdx ?? "";
			const activeYear = current?.dataset.entryId ?? "";

			segments.forEach((segment) => {
				segment.classList.toggle("is-active", !!current && segment.dataset.eraIdx === activeEra);
			});

			years.forEach((year) => {
				year.classList.toggle("is-active", !!current && year.dataset.year === activeYear);
			});
		};

		const schedule = () => {
			if (!frame) {
				frame = requestAnimationFrame(update);
			}
		};

		window.addEventListener("scroll", schedule, { passive: true });
		window.addEventListener("resize", schedule);
		window.addEventListener("load", schedule);
		// Re-measure after late layout shifts (fonts, images) settle
		window.setTimeout(schedule, 400);
		window.setTimeout(schedule, 1200);
		update();
	}
</script>
