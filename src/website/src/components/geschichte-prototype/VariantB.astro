---
// PROTOTYPE (throwaway) — Variant B «Epochen»: era tabs at the top, one open article column
// per era, no folding at all, image beside the text. View via /geschichte?proto=B
import type { PrototypeGroup } from "./types";
import { Image } from "astro:assets";

interface Props {
	groups: PrototypeGroup[];
}

const { groups } = Astro.props;
---

<div class="gp-b" data-gp-b>
	<div class="gp-b__tabs" role="tablist" aria-label="Epochen">
		{
			groups.map((group, index) => (
				<button
					type="button"
					class="gp-b__tab"
					role="tab"
					data-gp-tab
					aria-selected={index === 0 ? "true" : "false"}
					id={`gp-b-tab-${index}`}
				>
					<span class="gp-b__tab-title">{group.title}</span>
					<span class="gp-b__tab-range">{group.rangeLabel}</span>
				</button>
			))
		}
	</div>

	{
		groups.map((group, index) => (
			<section
				class="gp-b__panel"
				role="tabpanel"
				data-gp-panel
				hidden={index !== 0}
				aria-labelledby={`gp-b-tab-${index}`}
			>
				{group.message && <p class="gp-b__message">{group.message}</p>}
				{group.entries.map((entry) => (
					<article class="gp-b__article">
						<header class="gp-b__head">
							<span class="gp-b__date">{entry.formattedDate}</span>
							<div class="gp-b__title">
								<h4>{entry.title}</h4>
								{entry.subtitle && <p>{entry.subtitle}</p>}
							</div>
						</header>
						{(entry.image || entry.hasContent) && (
							<div class="timeline-content gp-b__body">
								<div class="gp-b__text">
									{entry.hasContent && <entry.Content />}
								</div>
								{entry.image && (
									<button
										type="button"
										class="timeline-image-trigger"
										data-image-src={entry.image.src}
										data-image-alt={`Bild zu ${entry.title}`}
										aria-label={`Bild zu ${entry.title} vergrößern`}
									>
										<Image src={entry.image} alt={`Bild zu ${entry.title}`} loading="lazy" />
									</button>
								)}
							</div>
						)}
					</article>
				))}
			</section>
		))
	}
</div>

<style>
	.gp-b {
		display: flex;
		flex-direction: column;
	}

	.gp-b__tabs {
		position: sticky;
		top: 0;
		z-index: 6;
		display: flex;
		gap: 0.5rem;
		overflow-x: auto;
		scrollbar-width: none;
		padding: 0.7rem 0.1rem;
		background: rgba(0, 0, 0, 0.42);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.22);
	}

	.gp-b__tabs::-webkit-scrollbar {
		display: none;
	}

	.gp-b__tab {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.2rem;
		padding: 0.55rem 0.9rem;
		color: inherit;
		background: rgba(255, 255, 255, 0.07);
		border: 1px solid rgba(255, 255, 255, 0.24);
		border-radius: 0.35rem;
		cursor: pointer;
		white-space: nowrap;
	}

	.gp-b__tab[aria-selected="true"] {
		background: rgba(255, 255, 255, 0.2);
		border-color: rgba(255, 255, 255, 0.6);
	}

	.gp-b__tab-title {
		font-family: var(--font-heading);
		font-size: 1.05rem;
		font-weight: 500;
		line-height: 1.2;
	}

	.gp-b__tab-range {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		opacity: 0.8;
	}

	.gp-b__panel {
		padding: 0.9rem 0 2.5rem;
	}

	.gp-b__panel[hidden] {
		display: none;
	}

	.gp-b__message {
		margin: 0 0 0.9rem;
		line-height: 1.65;
		opacity: 0.9;
		white-space: pre-line;
		padding: 0 0.4rem;
	}

	.gp-b__article {
		padding: 0.9rem 0.4rem 1.15rem;
	}

	.gp-b__article + .gp-b__article {
		border-top: 1px solid rgba(255, 255, 255, 0.18);
	}

	.gp-b__head {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin-bottom: 0.4rem;
	}

	.gp-b__date {
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.85;
	}

	.gp-b__title h4 {
		font-family: var(--font-heading);
		font-size: 1.3rem;
		font-weight: 500;
		margin: 0;
		line-height: 1.3;
	}

	.gp-b__title p {
		margin: 0.35rem 0 0;
		opacity: 0.9;
		line-height: 1.5;
	}

	.gp-b__body {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 1.2rem;
		align-items: start;
	}

	.gp-b__text > * {
		margin: 0;
	}

	.gp-b .timeline-content :global(p) {
		line-height: 1.65;
		opacity: 0.95;
	}

	.gp-b .timeline-content :global(p + p) {
		margin-top: 0.75rem;
	}

	.gp-b .timeline-content :global(img) {
		display: block;
		max-width: 100%;
		height: auto;
	}

	.gp-b .timeline-content :global(img.timeline-markdown-image) {
		float: right;
		width: 13rem;
		margin: 0.2rem 0 0.8rem 1rem;
		border: 1px solid rgba(255, 255, 255, 0.2);
	}

	.gp-b .timeline-image-trigger {
		display: block;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		cursor: zoom-in;
		width: 13rem;
		max-width: 40vw;
	}

	.gp-b .timeline-image-trigger :global(img) {
		width: 100%;
		height: auto;
		object-fit: contain;
	}

	@media (max-width: 600px) {
		.gp-b__tabs {
			position: static;
		}

		.gp-b .timeline-content :global(img.timeline-markdown-image) {
			float: none;
			width: 100%;
			margin: 0.8rem 0;
		}

		.gp-b__body {
			grid-template-columns: 1fr;
		}

		.gp-b .timeline-image-trigger {
			width: 100%;
			max-width: none;
		}
	}
</style>

<script>
	const root = document.querySelector<HTMLElement>("[data-gp-b]");

	if (root) {
		const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-gp-tab]"));
		const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-gp-panel]"));

		const select = (index: number) => {
			tabs.forEach((tab, tabIndex) => {
				tab.setAttribute("aria-selected", tabIndex === index ? "true" : "false");
			});
			panels.forEach((panel, panelIndex) => {
				panel.hidden = panelIndex !== index;
			});
		};

		tabs.forEach((tab, index) => {
			tab.addEventListener("click", () => select(index));
		});
	}
</script>
